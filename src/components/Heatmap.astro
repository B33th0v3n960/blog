---
import "../styles/global.css";
import { z } from "zod";

export const prerender = false;
const githubToken = process.env.GITHUB_TOKEN;

const ContributionDaySchema = z.object({
  date: z.string(),
  contributionCount: z.number(),
});

const ContributionWeekSchema = z.object({
  contributionDays: z.array(ContributionDaySchema),
});

const GitHubContributionsResponseSchema = z.object({
  data: z.object({
    user: z.object({
      contributionsCollection: z.object({
        contributionCalendar: z.object({
          totalContributions: z.number(),
          weeks: z.array(ContributionWeekSchema),
        }),
      }),
    }),
  }),
});

async function getContributions(username: String, token: String) {
  try {
    const headers = { Authorization: `bearer ${token}` };
    const body = {
      query: `
      query($userName: String!) {
        user(login: $userName) {
          contributionsCollection {
            contributionCalendar {
              totalContributions
              weeks {
                contributionDays {
                  date
                  contributionCount
                }
              }
            }
          }
        }
      }
    `,
      variables: { userName: username },
    };

    const res = await fetch("https://api.github.com/graphql", {
      method: "POST",
      body: JSON.stringify(body),
      headers,
    });

    if (!res.ok) {
      throw new Error(`GitHub API error: ${res.status} ${res.statusText}`);
    }

    const json = await res.json();
    const { data } = GitHubContributionsResponseSchema.parse(json);
    return data.user.contributionsCollection.contributionCalendar;
  } catch (error) {
    console.error("Failed to fetch Github contributions data: ", error);
    return null;
  }
}

function getContributionOpacity(contributionCount: number) {
  if (contributionCount === 0) return "0.1";
  else if (contributionCount <= 5) return "0.4";
  else if (contributionCount <= 10) return "0.6";
  else if (contributionCount <= 15) return "0.8";
  else return "1.0";
}

const contributionData = await getContributions("B33th0v3n960", githubToken);
const weekPlaceholder = new Array<Number>(52).fill(0);
---

<div>
  {
    contributionData ? (
      <p>
        {contributionData?.totalContributions} contributions in the last year
      </p>
    ) : (
      <p>Failed to retrieve Github contribution data.</p>
    )
  }
  <ul>
    {
      contributionData
        ? contributionData?.weeks.map((week) =>
            week.contributionDays.map((day) => (
              <li>
                <div
                  style={`opacity: ${getContributionOpacity(day?.contributionCount)}`}
                />
                <label>{day?.date}</label>
              </li>
            )),
          )
        : weekPlaceholder?.map(() => (
            <li>
              <div class="placeholder" />
            </li>
            <li>
              <div class="placeholder" />
            </li>
            <li>
              <div class="placeholder" />
            </li>
            <li>
              <div class="placeholder" />
            </li>
            <li>
              <div class="placeholder" />
            </li>
            <li>
              <div class="placeholder" />
            </li>
            <li>
              <div class="placeholder" />
            </li>
          ))
    }
  </ul>
</div>

<script>
  const grid = document.querySelector("ul");
  if (grid) grid.scrollLeft = grid.scrollWidth;
</script>

<style>
  ul {
    width: 100%;
    overflow: scroll;
    scroll-snap-align: end;
    border: var(--default-border);
    padding: var(--space-xs);
    display: grid;
    grid-template-rows: repeat(7, 1fr);
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    gap: var(--space-xs);
  }

  li {
    list-style: none;
    position: relative;

    div {
      background-color: var(--fg-primary);
      width: 15px;
      height: 15px;
    }

    .placeholder {
      background-color: var(--fg-primary);
      width: 15px;
      height: 15px;
      opacity: 0.1;
    }

    label {
      display: none;

      position: absolute;
      background-color: var(--fg-secondary);
      color: var(--bg-base);
      width: max-content;
    }

    :hover {
      label {
        display: inline;
      }
    }
  }
</style>
